# SECURITY: Block all npm install scripts by default.
#
# A malicious package can run arbitrary code via preinstall/install/postinstall
# scripts triggered by `npm install`. Most packages don't need them; the few
# that do (native bindings, build steps) are listed in package.json's
# "install:safe" script and rebuilt explicitly.
#
# Consequence: `npm install` alone will leave native packages (better-sqlite3,
# sharp, prisma engines, etc.) unbuilt. Use `npm run install:safe` instead.
# See package.json scripts.install:safe for the trusted-package allowlist.
ignore-scripts=true
