// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BETTER AUTH MODELS
// These tables are managed by Better Auth for authentication
// ============================================

/**
 * User - The authenticated user
 *
 * This stores basic profile information. Better Auth creates this
 * when someone registers. The 'id' is a unique string (not auto-increment)
 * because Better Auth generates secure random IDs.
 */
model User {
  id            String    @id
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profile fields
  displayName      String?            // Public display name
  bio              String?            // Short bio/description
  location         String?            // Optional location
  website          String?            // Personal website URL
  username         String?   @unique  // URL-friendly identifier (e.g., "violet_lover")

  // Social links
  socialInstagram  String?            // Instagram username
  socialFacebook   String?            // Facebook URL
  socialTwitter    String?            // Twitter/X username

  // Privacy settings
  profileIsPublic  Boolean   @default(true)   // Whether profile is visible to others
  showEmail        Boolean   @default(false)  // Show email on public profile

  // Memberships/Affiliations
  isAvsaMember     Boolean   @default(false)  // AVSA member
  localClub        String?                    // Local violet club name
  otherAffiliation String?                    // Other groups/organizations

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // Your app's relations - connect users to their data
  lists      List[]
  photos     PlantPhoto[]
  reviews    Review[]
  userPlants UserPlant[]
}

/**
 * Session - Active login sessions
 *
 * Each time a user logs in, a Session is created. The 'token' is stored
 * as an httpOnly cookie in the browser. When a request comes in, Better Auth
 * looks up the session by token to identify the user.
 *
 * You can query this table to see who's logged in!
 * Try: SELECT * FROM "Session" to see active sessions
 */
model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Account - Links users to authentication providers
 *
 * For email/password auth, this stores the hashed password.
 * If you later add Google/GitHub login, each provider gets its own Account.
 * One User can have multiple Accounts (email + Google + GitHub).
 */
model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // Hashed password for email/password auth
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Verification - Email verification and password reset tokens
 *
 * When a user requests a password reset or needs to verify their email,
 * a token is created here. These expire quickly for security.
 */
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================
// YOUR APPLICATION MODELS
// ============================================

model Plant {
  id                    Int       @id @default(autoincrement())
  recNum                Int?
  name                  String
  hybridizer            String?
  habit                 String?
  regNum                String?
  regDate               String?
  blossom               String?
  foliage               String?
  altReg                String?
  vintage               String?
  engTrans              String?
  alias                 String?
  lineage               String?
  imageUrl              String?   // Primary display image (main size, 1024px)
  thumbnailUrl          String?   // Thumbnail for catalog grid (300x300)
  featuredPhotos        String[]  // Up to 5 official catalog photos (main URLs)
  description           String?   // Pre-computed: "Name (regNum) MM/DD/YYYY (hybridizer) blossom. foliage. habit."

  // Catalog management
  isInCatalog           Boolean   @default(false)
  createdByUserId       String?
  contributionStatus    String?   // null, 'pending', 'approved', 'rejected'

  // Popularity tracking
  collectionCount       Int       @default(0)  // Number of users with this plant in their collection
  lastCollected         DateTime?              // Most recent time someone added to their collection
  extinctionStatus      String?                // null, 'likely_extinct', 'confirmed_extinct', 'rediscovered'

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  userPlants            UserPlant[]   // Users who own an instance of this variety
  userPhotos            PlantPhoto[]
  reviews               Review[]
  plantTags             PlantTag[]
}

model List {
  id          Int      @id @default(autoincrement())
  userId      String   // Required - every list belongs to a user
  name        String
  description String?
  color       String?  // Hex color for UI
  isDefault   Boolean  @default(false)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listPlants  ListPlant[]

  @@unique([userId, name])  // Same user can't have two lists with same name
}

model ListPlant {
  id            Int       @id @default(autoincrement())
  listId        Int
  userPlantId   Int
  dateAdded     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  // Relations
  list          List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  userPlant     UserPlant @relation(fields: [userPlantId], references: [id], onDelete: Cascade)

  @@unique([listId, userPlantId]) // A user-violet can only be in a given list once
}

/**
 * UserPlant - A user's personal instance of a violet
 *
 * This is the "user-violet": a specific physical plant that a user owns or tracks.
 * It can either reference a catalog variety (catalogPlantId set) or be a fully
 * custom entry the user created themselves (catalogPlantId null, customName set).
 *
 * One UserPlant can belong to multiple Lists via ListPlant.
 * Notes and personal data live here, not on ListPlant.
 */
model UserPlant {
  id               Int       @id @default(autoincrement())
  userId           String    // Always owned by a specific user

  // Optional link to a catalog variety (null = fully custom entry)
  catalogPlantId   Int?

  // Custom fields — used when catalogPlantId is null, or to store personal overrides
  customName       String?
  customHybridizer String?
  customBlossom    String?
  customFoliage    String?
  customHabit      String?

  // Personal tracking
  customNotes      String?   // Notes about this specific plant instance
  dateAcquired     DateTime?
  sourceNotes      String?   // e.g., "Leaf pull from Sara, March 2025"

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogPlant     Plant?    @relation(fields: [catalogPlantId], references: [id], onDelete: SetNull)
  listEntries      ListPlant[]

  @@index([userId])
  @@index([catalogPlantId])
}

model PlantPhoto {
  id           Int      @id @default(autoincrement())
  plantId      Int
  userId       String?  // Who uploaded it (optional - allows anonymous uploads)
  imageUrl     String   // Main image (1024px)
  thumbnailUrl String?  // Thumbnail (300x300) for gallery grids
  caption      String?
  uploadedAt   DateTime @default(now())

  // Relations
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Review {
  id          Int      @id @default(autoincrement())
  plantId     Int
  userId      String?  // Who wrote it (optional - allows anonymous reviews)
  userName    String?  // Display name (derived from User.name when logged in)
  rating      Int?     // Optional 1-5 stars
  title       String?  // e.g., "Easy bloomer!"
  content     String   // The actual review
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([plantId, userId]) // One review per user per plant
}

// ============================================
// TAG SYSTEM
// Categorizes plants by attributes like color, bloom type, foliage, etc.
// ============================================

/**
 * Tag - A category label that can be applied to plants
 *
 * Tags are organized by category (e.g., 'color', 'bloom_type', 'foliage')
 * and have a display name and optional color for UI rendering.
 */
model Tag {
  id          Int         @id @default(autoincrement())
  category    String      // e.g., 'color', 'bloom_type', 'foliage', 'habit'
  name        String      // e.g., 'pink', 'double', 'variegated'
  displayName String      // e.g., 'Pink', 'Double', 'Variegated'
  color       String?     // Hex color for UI chip display (e.g., '#FF69B4' for pink)
  sortOrder   Int         @default(0)  // For ordering tags within a category
  createdAt   DateTime    @default(now())

  // Relations
  plantTags   PlantTag[]

  @@unique([category, name])  // Each tag name is unique within its category
  @@index([category])
}

/**
 * PlantTag - Junction table linking plants to tags
 *
 * A plant can have multiple tags, and tags can apply to multiple plants.
 * The 'source' field tracks whether the tag was auto-generated or user-suggested.
 */
model PlantTag {
  id          Int      @id @default(autoincrement())
  plantId     Int
  tagId       Int
  source      String   @default("auto")  // 'auto' (system-generated) or 'user' (suggested)
  confidence  Float?   // For auto-tags: how confident the match was (0.0-1.0)
  createdAt   DateTime @default(now())

  // Relations
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([plantId, tagId])  // A plant can only have each tag once
  @@index([tagId])
}