# ===========================================
# Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git - it contains secrets!
# ===========================================

# Database connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# For local development without password:
DATABASE_URL="postgresql://USERNAME@localhost:5432/violetteer"

# For production with password:
# DATABASE_URL="postgresql://user:password@your-host.com:5432/violetteer"

# ===========================================
# Digital Ocean Spaces (Image Storage)
# ===========================================
# 1. Create account at https://digitalocean.com
# 2. Create a Space with CDN enabled
# 3. Generate Spaces API keys (API > Spaces Keys)
#
# Endpoint: Your region without https:// (e.g., nyc3.digitaloceanspaces.com)
# Region: Just the region code (e.g., nyc3, sfo3)
# Bucket: Your Space name
# CDN URL: Full CDN URL with https:// (e.g., https://my-space.nyc3.cdn.digitaloceanspaces.com)

DO_SPACES_ENDPOINT="nyc3.digitaloceanspaces.com"
DO_SPACES_REGION="nyc3"
DO_SPACES_BUCKET="your-space-name"
DO_SPACES_ACCESS_KEY="your_access_key"
DO_SPACES_SECRET_KEY="your_secret_key"
DO_SPACES_CDN_URL="https://your-space-name.nyc3.cdn.digitaloceanspaces.com"
